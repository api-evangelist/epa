{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/epa/refs/heads/main/json-structure/cam-qa-cert-rata-traverse-dto-structure.json",
  "name": "RataTraverseDTO",
  "description": "RataTraverseDTO schema from QA Certification Management OpenAPI Specification",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "example": "12345"
    },
    "flowRataRunId": {
      "type": "string",
      "example": "12345"
    },
    "calculatedCalculatedVelocity": {
      "type": "double",
      "example": 35.5
    },
    "userId": {
      "type": "string",
      "example": "12345"
    },
    "addDate": {
      "type": "string",
      "example": "string"
    },
    "updateDate": {
      "type": "string",
      "example": "string"
    },
    "probeId": {
      "type": "string",
      "maxLength": 11,
      "example": "12345"
    },
    "probeTypeCode": {
      "type": "string",
      "example": "string"
    },
    "pressureMeasureCode": {
      "type": "string",
      "example": "string"
    },
    "methodTraversePointId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3,
      "example": "12345"
    },
    "velocityCalibrationCoefficient": {
      "type": "double",
      "example": 0.0
    },
    "lastProbeDate": {
      "type": "datetime",
      "example": "2024-01-15T12:00:00Z"
    },
    "averageVelocityDifferencePressure": {
      "type": "double",
      "example": 0.0
    },
    "averageSquareVelocityDifferencePressure": {
      "type": "double",
      "example": 0.0
    },
    "tStackTemperature": {
      "type": "double",
      "example": 0.0
    },
    "pointUsedIndicator": {
      "type": "double",
      "example": 0.0
    },
    "numberWallEffectsPoints": {
      "type": "double",
      "example": 0.0
    },
    "yawAngle": {
      "type": "double",
      "example": 0.0
    },
    "pitchAngle": {
      "type": "double",
      "example": 0.0
    },
    "calculatedVelocity": {
      "type": "double",
      "example": 35.5
    },
    "replacementVelocity": {
      "type": "double",
      "example": 0.0
    }
  },
  "required": [
    "id",
    "flowRataRunId",
    "calculatedCalculatedVelocity",
    "userId",
    "addDate",
    "updateDate",
    "probeId",
    "probeTypeCode",
    "pressureMeasureCode",
    "methodTraversePointId",
    "velocityCalibrationCoefficient",
    "lastProbeDate",
    "tStackTemperature"
