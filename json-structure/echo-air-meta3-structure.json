{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/epa/refs/heads/main/json-structure/echo-air-meta3-structure.json",
  "name": "meta3",
  "description": "Results Column Object",
  "type": "object",
  "properties": {
    "ColumnID": {
      "type": "string",
      "example": "12345"
    },
    "ColumnName": {
      "type": "string",
      "example": "EPA Facility"
    },
    "DataLength": {
      "type": "string",
      "description": "Data length for EPA program database column.",
      "example": "10"
    },
    "DataType": {
      "type": "string",
      "description": "Data type for EPA program database column.",
      "example": "NUMBER"
    },
    "Description": {
      "type": "string",
      "example": "string"
    },
    "ObjectName": {
      "type": "string",
      "description": "The JSON name used for the database column.",
      "example": "CaseName"
    }
  },
  "required": [
    "ColumnName",
    "DataType",
    "DataLength",
    "ColumnID",
    "ObjectName",
    "Description"
  ]
}