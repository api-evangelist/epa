{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/epa/refs/heads/main/json-structure/cip-service-flow-accumulation-resp-structure.json",
  "name": "flow_accumulation_resp",
  "description": "flow_accumulation_resp schema from CIP-service Indexing API",
  "type": "object",
  "properties": {
    "flow_accumulation": {
      "type": "string",
      "example": "string"
    },
    "image_format": {
      "$ref": "#/components/schemas/image_format"
    },
    "image_bbox": {
      "type": "array",
      "items": {
        "type": "double"
      },
      "example": [
        0.0
      ]
    },
    "max_accumulation": {
      "type": "int32",
      "example": 35.5
    },
    "max_accumulation_x": {
      "type": "int32",
      "example": 35.5
    },
    "max_accumulation_y": {
      "type": "int32",
      "example": 35.5
    },
    "max_accumulation_pt": {
      "type": "int32",
      "example": 35.5
    },
    "raster_srid": {
      "type": "int32",
      "example": 0
    },
    "nhdplus_version": {
      "$ref": "#/components/schemas/nhdplus_version",
      "default": "nhdplus_h"
    },
    "return_code": {
      "$ref": "#/components/schemas/return_code"
    },
    "status_message": {
      "$ref": "#/components/schemas/status_message"
    }
  }
}