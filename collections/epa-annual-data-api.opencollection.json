{
  "opencollection": "1.0.0",
  "info": {
    "name": "EPA Air Quality System (AQS) Account Type Codes Annual Data API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Annual Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Annual Data by Site",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/annualData/bySite",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Registered email address."
              },
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Account-specific access key."
              },
              {
                "name": "param",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of up to 5 AQS 5-digit parameter codes."
              },
              {
                "name": "bdate",
                "value": "",
                "type": "query",
                "description": "Begin date (YYYYMMDD)."
              },
              {
                "name": "edate",
                "value": "",
                "type": "query",
                "description": "End date (YYYYMMDD). Must be in the same year as bdate for most services."
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "2-digit state FIPS code."
              },
              {
                "name": "county",
                "value": "",
                "type": "query",
                "description": "3-digit county code."
              },
              {
                "name": "site",
                "value": "",
                "type": "query",
                "description": "4-digit site code."
              },
              {
                "name": "cbdate",
                "value": "",
                "type": "query",
                "description": "Optional change begin date (returns records updated since cbdate)."
              },
              {
                "name": "cedate",
                "value": "",
                "type": "query",
                "description": "Optional change end date."
              }
            ]
          },
          "docs": "Get Annual Data by Site"
        },
