{
  "opencollection": "1.0.0",
  "info": {
    "name": "EPA Air Quality System (AQS) Account Type Codes Bap API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Bap",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get User's SAM.gov Data from the BAP.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/api/bap/sam"
          },
          "docs": "Get User's SAM.gov Data from the BAP."
        },
        {
          "info": {
            "name": "Get User's Form Submissions Statuses from the BAP.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/api/bap/submissions"
          },
          "docs": "Get User's Form Submissions Statuses from the BAP."
        }
      ]
    }
  ],
  "bundled": true
}