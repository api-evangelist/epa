{
  "opencollection": "1.0.0",
  "info": {
    "name": "EPA Air Quality System (AQS) Account Type Codes Rata Traverse API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Rata Traverse",
        "type": "folder"
      },
      "items": [
        {
