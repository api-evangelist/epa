          "info": {
            "name": "List States",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/list/states",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Registered email address."
              },
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Account-specific access key."
              }
            ]
          },
          "docs": "List States"
        },
