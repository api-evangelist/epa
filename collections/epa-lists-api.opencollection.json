{
  "opencollection": "1.0.0",
  "info": {
    "name": "EPA Air Quality System (AQS) Account Type Codes Lists API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
