{
  "opencollection": "1.0.0",
  "info": {
    "name": "US EPA How's My Waterway",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "How's My Waterway",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /api/configFiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://mywaterway-stage.app.cloud.gov/api/configFiles"
          }
        },
        {
          "info": {
            "name": "GET /api/health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://mywaterway-stage.app.cloud.gov/api/health"
          }
        },
        {
          "info": {
            "name": "GET /api/supportedBrowsers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://mywaterway-stage.app.cloud.gov/api/supportedBrowsers"
          }
        }
      ]
    }
  ],
  "bundled": true
}