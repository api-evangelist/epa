{
  "opencollection": "1.0.0",
  "info": {
    "name": "EPA Air Quality System (AQS) Account Type Codes Unit Fuels API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Unit Fuels",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "UnitFuelController_getUnitFuels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/monitor-plan-mgmt/units/:unitId/unit-fuels",
            "params": [
              {
                "name": "unitId",
                "value": "0",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}