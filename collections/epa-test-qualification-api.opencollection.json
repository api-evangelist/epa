{
  "opencollection": "1.0.0",
  "info": {
    "name": "EPA Air Quality System (AQS) Account Type Codes Test Qualification API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Test Qualification",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "TestQualificationController_getTestQualifications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/qa-certification-mgmt/locations/:locId/test-summary/:testSumId/test-qualifications",
            "params": [
              {
                "name": "locId",
                "value": "12345",
                "type": "path"
              },
              {
                "name": "testSumId",
                "value": "12345",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "TestQualificationController_getTestQualification",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/qa-certification-mgmt/locations/:locId/test-summary/:testSumId/test-qualifications/:id",
            "params": [
              {
                "name": "locId",
                "value": "12345",
                "type": "path"
              },
              {
                "name": "testSumId",
                "value": "12345",
                "type": "path"
              },
              {
                "name": "id",
                "value": "12345",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}