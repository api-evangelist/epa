{
  "opencollection": "1.0.0",
  "info": {
    "name": "EPA Air Quality System (AQS) Account Type Codes Sign Up API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sign Up",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Register for API Key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/signup",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Registered email address."
              }
            ]
          },
          "docs": "Register for API Key"
        }
      ]
    }
  ],
  "bundled": true
}