{
  "opencollection": "1.0.0",
  "info": {
    "name": "EPA Air Quality System (AQS) Account Type Codes Apportioned MATS Emissions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Apportioned MATS Emissions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "MatsApportionedEmissionsController_getApplicableEmissions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/emissions-mgmt/emissions/apportioned/mats/attributes/applicable",
            "params": [
              {
                "name": "year",
                "value": "2024",
                "type": "query",
                "description": "The calendar year during which activity occurred."
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}