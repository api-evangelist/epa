{
  "opencollection": "1.0.0",
  "info": {
    "name": "CAMD Administrative & General Services OpenAPI Specification",
    "version": "v2.0.146 published: Thu Mar 26 2026"
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "HealthController_check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.epa.gov/easey/camd-services/health"
          }
        }
      ]
    },
    {
      "info": {
        "name": "Bulk Files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "BulkFileController_getBulkFiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.epa.gov/easey/camd-services/bulk-files",
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves a list of bulk data files and their metadata from S3."
        }
      ]
    },
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ReportController_getAvailableReports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.epa.gov/easey/camd-services/reports/list",
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves list of official reports available."
        },
        {
          "info": {
            "name": "ReportController_getReport",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.epa.gov/easey/camd-services/reports",
            "params": [
              {
                "name": "reportCode",
                "value": "string",
                "type": "query"
              },
              {
                "name": "facilityId",
                "value": "0",
                "type": "query"
              },
              {
                "name": "monitorPlanId",
                "value": "12345",
                "type": "query"
              },
              {
                "name": "testId",
                "value": "12345",
                "type": "query"
              },
              {
                "name": "qceId",
                "value": "12345",
                "type": "query"
              },
              {
                "name": "teeId",
                "value": "12345",
                "type": "query"
              },
              {
                "name": "year",
                "value": "2024",
                "type": "query"
              },
              {
                "name": "quarter",
                "value": "0",
                "type": "query"
              },
              {
                "name": "locationId",
                "value": "12345",
                "type": "query"
              },
              {
                "name": "reportingPeriodIds",
                "value": "12345",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves official data for various reports based on criteria."
        }
      ]
    },
    {
      "info": {
        "name": "Support",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "MailController_getEmailRecipientList",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.epa.gov/easey/camd-services/support/email/emailRecipientList",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves a list of email recipients based on email type and plant IDs."
        }
      ]
    }
  ],
  "bundled": true
}