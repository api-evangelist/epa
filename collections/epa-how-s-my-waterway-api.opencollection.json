{
  "opencollection": "1.0.0",
  "info": {
    "name": "EPA Air Quality System (AQS) Account Type Codes How's My Waterway API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "How's My Waterway",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /api/configFiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/api/configFiles"
          }
        },
        {
          "info": {
            "name": "GET /api/health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/api/health"
          }
        },
        {
          "info": {
            "name": "GET /api/supportedBrowsers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/api/supportedBrowsers"
          }
        }
      ]
    }
  ],
  "bundled": true
}