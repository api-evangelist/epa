{
  "opencollection": "1.0.0",
  "info": {
    "name": "EPA Air Quality System (AQS) Account Type Codes Logout API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logout",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "/logout",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/logout"
          },
          "docs": "/logout"
        },
        {
          "info": {
            "name": "/logout/callback",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/logout/callback"
          },
          "docs": "/logout/callback"
        },
        {
          "info": {
            "name": "/logout/callback",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://aqs.epa.gov/data/api/logout/callback"
          },
          "docs": "/logout/callback"
        }
      ]
    }
  ],
  "bundled": true
}