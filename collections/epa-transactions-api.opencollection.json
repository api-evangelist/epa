{
  "opencollection": "1.0.0",
  "info": {
    "name": "EPA Air Quality System (AQS) Account Type Codes Transactions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Transactions Sample by Site",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/transactionsSample/bySite",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Registered email address."
              },
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Account-specific access key."
              },
              {
                "name": "param",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of up to 5 AQS 5-digit parameter codes."
              },
              {
                "name": "bdate",
                "value": "",
                "type": "query",
                "description": "Begin date (YYYYMMDD)."
              },
              {
                "name": "edate",
                "value": "",
                "type": "query",
                "description": "End date (YYYYMMDD). Must be in the same year as bdate for most services."
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "2-digit state FIPS code."
              },
              {
                "name": "county",
                "value": "",
                "type": "query",
                "description": "3-digit county code."
              },
              {
                "name": "site",
                "value": "",
                "type": "query",
                "description": "4-digit site code."
              },
              {
                "name": "cbdate",
                "value": "",
                "type": "query",
                "description": "Optional change begin date (returns records updated since cbdate)."
              },
              {
                "name": "cedate",
                "value": "",
                "type": "query",
                "description": "Optional change end date."
              }
            ]
          },
          "docs": "Transactions Sample by Site"
        },
        {
          "info": {
            "name": "Transactions Sample by State",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/transactionsSample/byState",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Registered email address."
              },
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Account-specific access key."
              },
              {
                "name": "param",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of up to 5 AQS 5-digit parameter codes."
              },
              {
                "name": "bdate",
                "value": "",
                "type": "query",
                "description": "Begin date (YYYYMMDD)."
              },
              {
                "name": "edate",
                "value": "",
                "type": "query",
                "description": "End date (YYYYMMDD). Must be in the same year as bdate for most services."
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "2-digit state FIPS code."
              },
              {
                "name": "cbdate",
                "value": "",
                "type": "query",
                "description": "Optional change begin date (returns records updated since cbdate)."
              },
              {
                "name": "cedate",
                "value": "",
                "type": "query",
                "description": "Optional change end date."
              }
            ]
          },
          "docs": "Transactions Sample by State"
        },
        {
          "info": {
            "name": "Transactions QA Annual by State",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aqs.epa.gov/data/api/transactionsQaAnnualPerformanceEvaluations/byState",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Registered email address."
              },
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Account-specific access key."
              },
              {
                "name": "param",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of up to 5 AQS 5-digit parameter codes."
              },
              {
                "name": "bdate",
                "value": "",
                "type": "query",
                "description": "Begin date (YYYYMMDD)."
              },
              {
                "name": "edate",
                "value": "",
                "type": "query",
                "description": "End date (YYYYMMDD). Must be in the same year as bdate for most services."
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "2-digit state FIPS code."
              }
            ]
          },
          "docs": "Transactions QA Annual by State"
        }
      ]
    }
  ],
  "bundled": true
}