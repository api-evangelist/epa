  "info": {
    "_postman_id": "cf29d6f8-c808-4b55-9926-25aa3d70a1e9",
    "name": "EPA Air Quality System (AQS) Account Type Codes Rata Summary API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Air Quality System (AQS) Data Mart API provides programmatic access to ambient air\nsample data collected by state, local, tribal and federal air pollution control agencies\nfrom thousands of monitors across the United States. The API exposes monitor metadata,\nraw sample observations, daily/quarterly/annual aggregates, and quality assurance results.\n\n\nContact Support:\n Name: AQS Data Mart Support\n Email: aqsdatamart@epa.gov",
      "type": "text/plain"
    }
