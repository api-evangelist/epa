      "item": [
        {
          "name": "Register for API Key",
          "id": "da8d045f-b314-4934-a014-8327e7303f71",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/signup?email=<email>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "signup"
              ],
              "query": [
                {
                  "description": "(Required) Registered email address.",
                  "key": "email",
                  "value": "<email>"
                }
              ]
            }
          },
          "response": [
            {
              "id": "9bfff32f-e88c-4ef2-a33b-0feb75035a5b",
              "name": "Verification email sent.",
              "originalRequest": {
