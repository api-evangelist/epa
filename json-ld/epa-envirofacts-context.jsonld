{
  "@context": {
    "epa": "https://api-evangelist.com/epa/envirofacts#",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "GovernmentOrganization": "schema:GovernmentOrganization",
    "Dataset": "schema:Dataset",
    "Row": "epa:Row",
    "UvDaily": "epa:UvDaily",
    "UvHourly": "epa:UvHourly",
    "CITY": {
      "@id": "epa:CITY",
      "@type": "xsd:string"
    },
    "STATE": {
      "@id": "epa:STATE",
      "@type": "xsd:string"
    },
    "ZIP": {
      "@id": "epa:ZIP",
      "@type": "xsd:string"
    },
    "DATE": {
      "@id": "epa:DATE",
      "@type": "xsd:string"
    },
    "UV_INDEX": {
      "@id": "epa:UV_INDEX",
      "@type": "xsd:integer"
    },
    "DATE_TIME": {
      "@id": "epa:DATE_TIME",
      "@type": "xsd:string"
    },
    "UV_VALUE": {
      "@id": "epa:UV_VALUE",
      "@type": "xsd:integer"
    }
  }
}