      "format": "date-time",
      "type": "string",
      "example": "2024-01-15T12:00:00Z"
    },
    "endHour": {
      "type": "number",
      "example": 0.0
    },
    "endMinute": {
      "type": "number",
      "example": 0.0
    }
  },
  "required": [
    "runNumber",
    "beginDate",
    "beginHour",
    "beginMinute",
    "endDate",
